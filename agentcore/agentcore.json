      "entrypoint": "app/Compass/main.py",
      "codeLocation": "./",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "COMPASS_PROVIDER",
          "value": "bedrock"
        }
      ]
    }
  ],
