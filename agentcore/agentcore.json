{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "compass",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "compass",
    "project": "compass",
    "hackathon": "agents-for-humans"
  },
  "runtimes": [
    {
      "name": "Compass",
      "description": "A background agent that watches degree rules and speaks up only when silence costs the student something irreversible.",
